# ============================================
# APLICACIÓN - PRODUCCIÓN
# ============================================
APP_NAME="Callejon Diagon"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.onrender.com

# ============================================
# BASE DE DATOS - SUPABASE (POSTGRES)
# ============================================
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=tu_password_de_supabase
DB_SSLMODE=require

# ============================================
# SESIÓN
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=tu-dominio.onrender.com

# ============================================
# SANCTUM (SPA mode)
# ============================================
SANCTUM_STATEFUL_DOMAINS=tu-dominio.onrender.com

# ============================================
# CACHE Y QUEUE
# ============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================
# CRON JOB
# ============================================
CRON_SECRET=cambiar-por-token-largo-y-aleatorio

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_LEVEL=error